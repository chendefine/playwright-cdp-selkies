# chendefine/playwright-cdp-selkies — runtime configuration template.
#
#   cp .env.example .env    then uncomment/adjust what you need.
#
# Every variable below is optional: commented lines show the default that
# applies when it is unset or .env is missing. Values here also reach the
# container directly (env_file pass-through), so unlisted native SELKIES_*
# variables (e.g. SELKIES_FRAMERATE=30, SELKIES_TURN_URL=...) may be added.

# ---------- build (docker compose build) ----------
#PLAYWRIGHT_VERSION=1.63.0
#NODE_VERSION=24
#SELKIES_REF=4f076052f1eb3214fbf80deed4b18e9e1329bd87

# ---------- service toggles ----------
#ENABLE_SELKIES=true          # false = skip web UI + display + audio
#ENABLE_CDP=true              # false = skip chromium + CDP gateway
#ENABLE_HTTPS=false           # true = nginx also serves the web UI over TLS on
#                              #     container port 443 (fixed)

# ---------- HTTPS publishing (opt-in overlay) ----------
# The base compose file NEVER publishes the HTTPS port to the host. To publish
# it AND turn ENABLE_HTTPS on in one go, uncomment (docker compose reads
# COMPOSE_FILE from this .env):
#COMPOSE_FILE=compose.yaml:compose.https.yaml
# ENABLE_HTTPS=true without the overlay = HTTPS works only inside the docker
# network (e.g. behind another reverse proxy), nothing published to the host.

# ---------- GPU passthrough (opt-in overlay) ----------
# Pass the host GPU in so Chromium (WebGL, rasterization) and optionally the
# Selkies encoder use hardware acceleration instead of SwiftShader software
# rendering. Enable by adding the matching overlay to COMPOSE_FILE (colon-
# separated, combinable with the https overlay and with each other):
#   Intel/AMD (/dev/dri passthrough):   COMPOSE_FILE=compose.yaml:compose.gpu.yaml
#   NVIDIA (host needs nvidia-container-toolkit):
#                                       COMPOSE_FILE=compose.yaml:compose.gpu-nvidia.yaml
# CHROMIUM_GPU policy (single knob, also owns the SwiftShader fallback):
#   auto   (default) hardware GL when the container sees a GPU, else
#          SwiftShader software — WebGL always works
#   off    force software rendering even with a GPU attached
#   strict never allow SwiftShader (anti-fingerprinting): hardware GL only,
#          WebGL unavailable without a GPU
#CHROMIUM_GPU=auto

# ---------- ports (HOST-side publishing only) ----------
# The container always listens on fixed internal ports 80 (web HTTP),
# 443 (web HTTPS) and 9222 (CDP); these variables pick only the host ports.
#NGINX_HTTP_PORT=8080         # host port -> container 80 (web UI, HTTP)
#NGINX_HTTPS_PORT=8443        # host port -> container 443 (web UI, HTTPS;
#                              # only used with the compose.https.yaml overlay)
#CDP_PORT=9222                # host port -> container 9222 (CDP endpoint)

# ---------- TLS (HTTPS) ----------
# Certificate reuse: any EXISTING VALID pair is reused as-is (self-signed
# counts as valid; "valid" = parseable cert + key that belong together). A
# self-signed pair is generated only when no usable pair is found — into
# ${TLS_CERT_DIR} when writable (the ./tls bind mount, so it persists and is
# reused on later starts), otherwise into the container.
# Drop fullchain.pem + privkey.pem into ./tls to use your own certificate
# (compose mounts ${TLS_CERTS_HOST_DIR:-./tls} -> /etc/nginx/tls).
#TLS_CERT_DIR=/etc/nginx/tls
#TLS_CERT_FILE=/etc/nginx/tls/fullchain.pem
#TLS_KEY_FILE=/etc/nginx/tls/privkey.pem
#TLS_SELF_SIGNED_CN=localhost

# ---------- selkies ----------
# Set a password to enable the login screen (username defaults to "ubuntu",
# override with SELKIES_BASIC_AUTH_USER). Empty = no login.
#SELKIES_BASIC_AUTH_PASSWORD=
# h264enc | h264enc-striped | openh264enc | jpeg
#SELKIES_ENCODER=h264enc
# Extra CLI flags passed to `selkies`
#SELKIES_EXTRA_ARGS=

# ---------- chromium ----------
# 0 = headed on the Xvfb desktop (visible in the Selkies stream); 1 = headless
#CHROMIUM_HEADLESS=0
# Browser UI locale + Accept-Language (default English; e.g. zh-CN)
#CHROMIUM_LANG=en-US
# Page opened at startup
#CHROMIUM_START_URL=about:blank
# Extra chromium flags, e.g. --proxy-server=http://host:3128
#CHROMIUM_EXTRA_ARGS=
# Comma-separated feature names passed to chromium as --disable-features=.
# Default below (from compose.yaml) disables the HTTPS-First / HTTPS-Upgrade
# experiments so plain http:// pages are not auto-upgraded to https.
# Override with your own list, or set it EMPTY (CHROMIUM_DISABLE_FEATURES=)
# to drop the flag entirely.
#CHROMIUM_DISABLE_FEATURES=HttpsFirstBalancedModeAutoEnable,HttpsUpgrades,HttpsFirstModeV2

# ---------- desktop ----------
# Xvfb screen geometry WxHxD; also sizes the Selkies stream
#SCREEN_GEOMETRY=1920x1080x24
# Container timezone (UTC = default; any IANA zone, e.g. Asia/Shanghai)
#TZ=UTC

# ---------- container ----------
# /dev/shm size for chromium
#SHM_SIZE=1gb
# Host-side directories for the browser profile and TLS certificates
#CHROME_USER_DATA_HOST_DIR=./chrome-user-data
#TLS_CERTS_HOST_DIR=./tls

# ---------- docker network ----------
# Network the container attaches to. Unset = compose's own
# "<project>_default" network (today's behavior).
#NETWORK_NAME=
# false (default) = compose creates and manages the network (`down` removes
# it); true = the network already exists (e.g. shared with another stack) and
# compose only attaches to it, never creates/removes it.
#NETWORK_EXTERNAL=false
